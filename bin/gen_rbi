#!/usr/bin/env ruby
# frozen_string_literal: true

# Generates rbi/dsl.rbi (the Sorbet description of the DSL) from the compiler's
# SIG table and the body surface below (BODY_SURFACE), so Sorbet and the compiler
# cannot drift apart.
#
#   ruby bin/gen_rbi          write rbi/dsl.rbi
#   ruby bin/gen_rbi --check  exit 1 if rbi/dsl.rbi differs from what SIG produces
#
# Sorbet cannot constrain symbol VALUES (:i32 vs :bogus); the compiler's --check
# does that. This file only expresses nesting, keywords and argument types.
require "fileutils"

require_relative "../lib/axum_dsl/schema"

OUT = File.expand_path("../rbi/dsl.rbi", __dir__)

def scope(name) = "#{name.to_s.capitalize}Scope"

def sorbet_type(kind)
  return "String" if kind == :str
  return "T::Boolean" if kind == :bool
  return "T.any(Integer, Float)" if kind == :num
  return "Integer" if kind == :uint
  return "T.any(String, Integer, Float, T::Boolean)" if kind == :lit
  # a setting's value: a literal, or a symbol naming what the setting points at (`set :layout, :app`)
  return "T.any(String, Symbol, Integer, Float, T::Boolean)" if kind == :setting
  return "T.any(String, Integer, Float, T::Boolean, T::Array[T.any(String, Integer, Float)])" if kind == :default
  return "T::Hash[String, T.untyped]" if kind == :json || kind == :schema || kind == :hash
  return "T::Hash[Symbol, T.untyped]" if kind == :helper_kw
  return "T::Array[Symbol]" if %i[types htypes snakes file_checks].include?(kind)
  return "T::Hash[Symbol, Symbol]" if kind == :sqlargs
  return "T.untyped" if kind == :qreturns # list(:Note), :Note? or :i64: the compiler reads it with Prism
  return "T::Array[String]" if kind == :strs
  return "T.any(Symbol, String)" if kind == :model_name # model :Room, or "Account::Bot"
  return "T.any(Symbol, T::Hash[Symbol, Symbol])" if kind == :camel_or_actions # resources: one group, or one per action
  return "T.any(String, T::Hash[Symbol, String])" if kind == :str_or_actions # resources: one text, or one per action
  return "T.untyped" if kind == :lambda # -> { where(...) }: the compiler reads it with Prism
  return "T.any(Symbol, T.class_of(AxumDsl::Opaque))" if kind == :fieldtype # :i64, map(:i64), or a type a binding owns

  "Symbol"
end

# Returns ["sig { ... }", "def name(...); end"] for one SIG entry.
def method_src(name, sig)
  names = sig.fetch(:names)
  raise "#{name}: names and pos differ in length" unless names.size == sig.fetch(:pos).size

  optional = sig[:optional_pos] || 0
  sparams = names.each_with_index.map do |n, i|
    type = sorbet_type(sig[:pos][i])
    i >= names.size - optional && type != "T.untyped" ? "#{n}: T.nilable(#{type})" : "#{n}: #{type}"
  end
  defs = names.each_with_index.map { |n, i| i >= names.size - optional ? "#{n} = nil" : n.to_s }
  # Sorbet wants required keywords before optional ones; keep the table's order within each group.
  sig[:kw].partition { |_, (_, required)| required }.flatten(1).each do |key, (kind, required)|
    if required
      sparams << "#{key}: #{sorbet_type(kind)}"
      defs << "#{key}:"
    else
      sparams << "#{key}: T.nilable(#{sorbet_type(kind)})"
      defs << "#{key}: nil"
    end
  end
  case sig[:block]
  when :decls
    # A fragment holds what a file holds, and the file level IS this rbi's top level, which has no
    # scope class of its own: its block is untyped. Every other decl block names the class it binds.
    block_type = name == :fragment ? "T.untyped" : "T.proc.bind(#{scope(name)}).void"
    block_type = "T.nilable(#{block_type})" if sig[:optional_block]
    sparams << "blk: #{block_type}"
    defs << "&blk"
  when :body
    sparams << "blk: T.untyped"
    defs << "&blk"
  end
  sigline = sparams.empty? ? "sig { void }" : "sig { params(#{sparams.join(', ')}).void }"
  [sigline, "def #{name}(#{defs.join(', ')}); end"]
end

# The body surface: the calls a body makes by name, and the rbi each one gets. A body is typed as the top
# level of the DSL file (a route, a filter and a helper block is an untyped proc), so these are declared at
# the top level, after the SIG table. AxumDsl::Body::BODY_CALLS is the compiler's half of the same list,
# and test/test_body_surface.rb holds the two equal. The methods a body calls on a value
# (Body::ALLOWED_METHODS) are the other half of the surface: Sorbet's own String, Array and Hash RBIs
# declare those, so they are not named here.
#
# `params`, `setting` and `current` are each both a declaration and a read, and each is special-cased below: `params`
# gets a reader overload over the SIG table's declaration sig, and the SIG sigs of `setting` and `current` are
# replaced by one relaxed sig each, because Sorbet cannot pick an overload on a missing keyword argument.
BODY_SURFACE = {
  # params[:name] reads a route's input; the declaration sig follows this one, from the SIG table.
  params: ["sig { returns(T::Hash[T.any(Symbol, String), T.untyped]) }"],
  # errors[:name] reads the generated check()'s message for that field, and "" when the request passed it
  # (or that field had no violation): a String, never nil, so a body interpolates it with no conditional.
  # The value type is T.untyped rather than String because Sorbet types Hash#[] as T.nilable(V) whatever V
  # is: a String value type would make every errors[:name] nilable and force a T.must at each use.
  errors: ["sig { returns(T::Hash[T.any(Symbol, String), T.untyped]) }",
           "def errors; end"],
  # setting(:name) reads a declared setting; its declaration form's keywords are all optional here, because
  # one sig has to carry both call shapes (the compiler requires `env:` in the declaration form).
  setting: ["sig { params(name: Symbol, env: T.nilable(String), description: T.nilable(String), " \
                        "default: T.nilable(T.any(String, Integer, Float, T::Boolean)), optional: T.nilable(T::Boolean), " \
                        "secret: T.nilable(T::Boolean), type: T.nilable(Symbol)).returns(T.untyped) }",
            "def setting(name, env: nil, description: nil, default: nil, optional: nil, secret: nil, type: nil); end"],
  # The response helpers: values the emitter turns into ::axum::response::Response.
  text: ["sig { params(value: T.any(String, Integer, Float, T::Boolean), status: T.nilable(Integer), content_type: T.nilable(String)).returns(T.untyped) }",
         "def text(value, status: nil, content_type: nil); end"],
  html: ["sig { params(value: T.any(String, Integer, Float, T::Boolean), status: T.nilable(Integer), content_type: T.nilable(String)).returns(T.untyped) }",
         "def html(value, status: nil, content_type: nil); end"],
  json: ["sig { params(value: T.untyped, status: T.nilable(Integer), content_type: T.nilable(String)).returns(T.untyped) }",
         "def json(value, status: nil, content_type: nil); end"],
  redirect: ["sig { params(path: String, status: T.nilable(Integer), notice: T.nilable(Symbol), alert: T.nilable(Symbol)).returns(T.untyped) }",
             "def redirect(path, status: nil, notice: nil, alert: nil); end"],
  halt: ["sig { params(status: T.any(Integer, Symbol), body: T.untyped).returns(T.untyped) }",
         "def halt(status, body = nil); end"],
  # head(status) is Rails' `head :forbidden`: an empty text/html response from the action. The HEAD route verb
  # (`head "/path" do ... end`) shares this one relaxed sig, as `setting` and `current` do: one def, so Sorbet
  # sees no redefinition with another argument count.
  head: ["sig { params(status: T.any(Integer, Symbol, String), params: T.nilable(Symbol), description: T.nilable(String), skip: T.nilable(T::Array[Symbol]), cache: T.nilable(Symbol), also: T.nilable(T::Array[Symbol]), action: T.nilable(Symbol), blk: T.untyped).returns(T.untyped) }",
         "def head(status, params: nil, description: nil, skip: nil, cache: nil, also: nil, action: nil, &blk); end"],
  # render(name, locals:, layout:) answers with a view: a `.html` file beside the DSL file, read at compile
  # time and compiled into the emitted Rust, so the crate carries no template. `locals:` is untyped because
  # Sorbet cannot check that a hash's keys are exactly the names the view's markers read -- the compiler does
  # (the eight marker forms, `{% raw %}` among them, are in docs/views.md), and `layout: nil` opts a render
  # out of the `set :layout` default.
  render: ["sig { params(name: T.any(Symbol, String), locals: T.untyped, layout: T.nilable(T.any(Symbol, String)), status: T.nilable(Integer), content_type: T.nilable(String), frame_layout: T.nilable(T::Boolean)).returns(T.untyped) }",
           "def render(name, locals: nil, layout: nil, status: nil, content_type: nil, frame_layout: nil); end"],
  # send_file(path, content_type:): a response whose body is the file at a path computed when the request
  # runs. The content type is required because the compiler does not guess one from the path.
  send_file: ["sig { params(path: String, status: T.nilable(Integer), content_type: T.nilable(String), disposition: T.nilable(Symbol)).returns(T.untyped) }",
              "def send_file(path, status: nil, content_type: nil, disposition: nil); end"],
  # rails_signed_id(token, purpose:, secret:, check_expiry:): the integer id inside a Rails 8 signed ID, or nil.
  rails_signed_id: ["sig { params(token: String, purpose: String, secret: Symbol, check_expiry: T::Boolean).returns(T.nilable(Integer)) }",
                    "def rails_signed_id(token, purpose:, secret:, check_expiry: false); end"],
  # rails_signed_id_for(id, purpose:, secret:): the token Rails' `signed_id(purpose:)` writes for an integer id.
  rails_signed_id_for: ["sig { params(id: Integer, purpose: String, secret: Symbol, expires_in: Integer).returns(String) }",
                        "def rails_signed_id_for(id, purpose:, secret:, expires_in: 0); end"],
  # turbo_signed_stream_name(*parts, secret:): turbo-rails' Turbo::StreamsChannel.signed_stream_name.
  turbo_signed_stream_name: ["sig { params(parts: T.any(String, Symbol), secret: Symbol).returns(String) }",
                             "def turbo_signed_stream_name(*parts, secret:); end"],
  # global_id_param(model, id, app:): record.to_gid_param, the url-safe base64 of "gid://<app>/<Model>/<id>".
  global_id_param: ["sig { params(model: String, id: Integer, app: String).returns(String) }",
                    "def global_id_param(model, id, app:); end"],
  # rails_signed_global_id(model, id, app:, purpose:, secret:): record.attachable_sgid, the signed GlobalID.
  rails_signed_global_id: ["sig { params(model: String, id: Integer, app: String, secret: Symbol, purpose: T.nilable(String)).returns(String) }",
                           "def rails_signed_global_id(model, id, app:, secret:, purpose: nil); end"],
  # json_object("name" => value, ...): one JSON object with keys of different value types.
  json_object: ["sig { params(pairs: T::Hash[String, T.untyped]).returns(String) }",
                "def json_object(pairs); end"],
  # json_array(["{\"a\":1}", ...]): a JSON array of strings already serialized as objects.
  json_array: ["sig { params(values: T::Array[String]).returns(String) }",
               "def json_array(values); end"],
  # The Action Cable broadcasts (docs/cable.md): a JSON object to a broadcasting name, to the channel's own stream, or a
  # Turbo Stream tag to a stream's name; render_string is the markup the tag carries.
  broadcast: ["sig { params(name: String, message: T::Hash[String, T.untyped]).void }",
              "def broadcast(name, message); end"],
  broadcast_to: ["sig { params(message: T::Hash[String, T.untyped]).void }",
                 "def broadcast_to(message); end"],
  # Rails' close_remote_connections: every open connection of the user (an id, or a string current's string) is sent the remote disconnect and closed.
  close_remote_connections: ["sig { params(user: T.any(Integer, String), reconnect: T.nilable(T::Boolean)).void }",
                             "def close_remote_connections(user, reconnect: nil); end"],
  broadcast_turbo: ["sig { params(parts: T.any(String, Symbol), action: Symbol, target: String, html: T.nilable(String), maintain_scroll: T.nilable(T::Boolean)).void }",
                    "def broadcast_turbo(*parts, action:, target:, html: nil, maintain_scroll: nil); end"],
  # broadcast_<action>_to(streamable, *parts, target:, html:, app:): turbo-rails' broadcast_<action>_to, sugar for broadcast_turbo.
  broadcast_append_to: ["sig { params(streamable: T.untyped, parts: T.any(String, Symbol), target: String, html: String, maintain_scroll: T.nilable(T::Boolean), app: T.nilable(String)).void }",
                        "def broadcast_append_to(streamable, *parts, target:, html:, maintain_scroll: nil, app: nil); end"],
  broadcast_prepend_to: ["sig { params(streamable: T.untyped, parts: T.any(String, Symbol), target: String, html: String, maintain_scroll: T.nilable(T::Boolean), app: T.nilable(String)).void }",
                         "def broadcast_prepend_to(streamable, *parts, target:, html:, maintain_scroll: nil, app: nil); end"],
  broadcast_replace_to: ["sig { params(streamable: T.untyped, parts: T.any(String, Symbol), target: String, html: String, maintain_scroll: T.nilable(T::Boolean), app: T.nilable(String)).void }",
                         "def broadcast_replace_to(streamable, *parts, target:, html:, maintain_scroll: nil, app: nil); end"],
  broadcast_update_to: ["sig { params(streamable: T.untyped, parts: T.any(String, Symbol), target: String, html: String, maintain_scroll: T.nilable(T::Boolean), app: T.nilable(String)).void }",
                        "def broadcast_update_to(streamable, *parts, target:, html:, maintain_scroll: nil, app: nil); end"],
  broadcast_remove_to: ["sig { params(streamable: T.untyped, parts: T.any(String, Symbol), target: String, maintain_scroll: T.nilable(T::Boolean), app: T.nilable(String)).void }",
                        "def broadcast_remove_to(streamable, *parts, target:, maintain_scroll: nil, app: nil); end"],
  render_string: ["sig { params(name: T.any(Symbol, String), locals: T.untyped).returns(String) }",
                  "def render_string(name, locals: nil); end"],
  # urlsafe_base64(text): Base64.urlsafe_encode64 (padded).
  urlsafe_base64: ["sig { params(text: String).returns(String) }",
                   "def urlsafe_base64(text); end"],
  # url_encode(text): URI.encode_www_form_component, the query-string escaping Rails uses for a parameter.
  url_encode: ["sig { params(text: String).returns(String) }",
               "def url_encode(text); end"],
  # urlsafe_decode64(text): Base64.urlsafe_decode64 as UTF-8 text, nil where Ruby raises or the bytes are not text.
  urlsafe_decode64: ["sig { params(text: String).returns(T.nilable(String)) }",
                     "def urlsafe_decode64(text); end"],
  # qr_code_svg(text): RQRCode::QRCode.new(text).as_svg(viewbox: true, fill: :white, color: :black), nil past version 40.
  qr_code_svg: ["sig { params(text: String).returns(T.nilable(String)) }",
                "def qr_code_svg(text); end"],
  # opengraph_unfurl(url): Campfire's Opengraph::Metadata.from_url as UnfurlLinksController#create answers it; nil for no content.
  # image_variant(path, filename, width, height): Active Storage's resize_to_limit variant, made with libvips, as an upload.
  image_variant: ["sig { params(path: String, filename: String, width: Integer, height: Integer).returns(T.untyped) }",
                  "def image_variant(path, filename, width, height); end"],
  # attach(:avatar, owner_id, stored, fresh: true): what a `has_one_attached :avatar` of a model makes run, inside a transaction; stored is upload&.store_file(root).
  attach: ["sig { params(name: Symbol, owner_id: Integer, stored: T.untyped, fresh: T.nilable(T::Boolean)).returns(Integer) }",
           "def attach(name, owner_id, stored, fresh: nil); end"],
  opengraph_unfurl: ["sig { params(url: String).returns(T.nilable(String)) }",
                     "def opengraph_unfurl(url); end"],
  # web_push(...): one Web Push delivery, 1 when the subscription is to be invalidated.
  web_push: ["sig { params(endpoint: String, p256dh: String, auth: String, payload: String, vapid_public: String, vapid_private: String, subject: String).returns(Integer) }",
             "def web_push(endpoint, p256dh, auth, payload, vapid_public, vapid_private, subject); end"],
  # webhook_post(url, payload): Campfire's Webhook#deliver, the reply text or nil.
  webhook_post: ["sig { params(url: String, payload: String).returns(T.nilable(String)) }",
                 "def webhook_post(url, payload); end"],
  # later do ... end: work run after the route answers (a spawned task), as Rails' perform_later jobs.
  later: ["sig { params(blk: T.untyped).void }",
          "def later(&blk); end"],
  # The Active Storage disk service: blob.url, blob.signed_id's id, and the blob key inside a disk URL's signed key.
  active_storage_disk_path: ["sig { params(key: String, filename: String, content_type: String, secret: Symbol).returns(String) }",
                             "def active_storage_disk_path(key, filename, content_type, secret:); end"],
  active_storage_verified_id: ["sig { params(token: String, secret: Symbol).returns(T.nilable(Integer)) }",
                               "def active_storage_verified_id(token, secret:); end"],
  active_storage_verified_key: ["sig { params(token: String, secret: Symbol).returns(T.nilable(String)) }",
                                "def active_storage_verified_key(token, secret:); end"],
  active_storage_direct_upload_url: ["sig { params(key: String, content_type: String, byte_size: Integer, checksum: String, secret: Symbol).returns(String) }",
                                     "def active_storage_direct_upload_url(key, content_type, byte_size, checksum, secret:); end"],
  active_storage_disk_upload: ["sig { params(token: String, root: String, secret: Symbol).returns(Integer) }",
                               "def active_storage_disk_upload(token, root, secret:); end"],
  active_storage_blob_id: ["sig { params(id: Integer, secret: Symbol).returns(String) }",
                           "def active_storage_blob_id(id, secret:); end"],
  active_storage_key: ["sig { returns(String) }",
                       "def active_storage_key; end"],
  # inline_disposition(filename): the inline Content-Disposition header value of a file name.
  inline_disposition: ["sig { params(filename: String).returns(String) }",
                       "def inline_disposition(filename); end"],
  # crc32(text): Zlib.crc32(text), the unsigned 32-bit CRC-32 as an Integer.

  crc32: ["sig { params(text: String).returns(Integer) }",
          "def crc32(text); end"],
  # plain_text(html): ActionText::Content#to_plain_text of a stored body.
  plain_text: ["sig { params(html: String).returns(String) }",
               "def plain_text(html); end"],
  # h(value) escapes a value for HTML; raw(value) gives the same value with no escaping (the XSS door).
  h: ["sig { params(value: T.any(String, Integer, Float, T::Boolean)).returns(String) }",
      "def h(value); end"],
  raw: ["sig { params(value: T.any(String, Integer, Float, T::Boolean)).returns(String) }",
        "def raw(value); end"],
  # The two statements that say how the response is written; the compiler requires each on its own line.
  status: ["sig { params(code: T.any(Integer, Symbol)).returns(T.untyped) }",
           "def status(code); end"],
  content_type: ["sig { params(name: T.any(Symbol, String)).returns(T.untyped) }",
                 "def content_type(name); end"],
  # headers(...) is the third statement a response body may make: header lines on the response.
  headers: ["sig { params(headers: T::Hash[String, String]).returns(T.untyped) }",
            "def headers(headers); end"],
  # etag(value) is a route statement: the response's ETag, a computed string; a request whose
  # If-None-Match lists it is answered 304 with no body.
  etag: ["sig { params(value: String).returns(T.untyped) }",
         "def etag(value); end"],
  # `transaction do ... end` runs query/execute calls on one connection, commits on success and rolls
  # back on a database error (docs/database.md); its value is the block's final expression.
  transaction: ["sig { params(blk: T.untyped).returns(T.untyped) }",
                "def transaction(&blk); end"],
  # The server's own declarations a body may read.
  file_text: ["sig { params(name: Symbol).returns(String) }",
              "def file_text(name); end"],
  file_path: ["sig { params(name: Symbol).returns(String) }",
              "def file_path(name); end"],
  entry: ["sig { params(file: Symbol, name: Symbol).returns(String) }",
          "def entry(file, name); end"],
  entry_args: ["sig { params(file: Symbol, name: Symbol, args: T.untyped).returns(String) }",
               "def entry_args(file, name, **args); end"],
  # rust(:fn, args...) calls a function declared with rust_fn; the compiler checks it.
  rust: ["sig { params(name: Symbol, args: T.untyped).returns(T.untyped) }",
         "def rust(name, *args); end"],
  # Sessions (docs/sessions.md). cookie(:name) is the signed cookie's value, or nil when it is absent or does not
  # verify; `signed: false` reads a plain one and `format:` picks the signature's format. set_cookie and
  # delete_cookie are statements of a route body, like headers.
  cookie: ["sig { params(name: Symbol, signed: T.nilable(T::Boolean), format: T.nilable(Symbol)).returns(T.nilable(String)) }",
           "def cookie(name, signed: nil, format: nil); end"],
  set_cookie: ["sig { params(name: Symbol, value: String, http_only: T.nilable(T::Boolean), same_site: T.nilable(Symbol), " \
               "secure: T.nilable(T::Boolean), permanent: T.nilable(T::Boolean), max_age: T.nilable(Integer), " \
               "signed: T.nilable(T::Boolean), format: T.nilable(Symbol)).returns(T.untyped) }",
               "def set_cookie(name, value, http_only: nil, same_site: nil, secure: nil, permanent: nil, max_age: nil, signed: nil, format: nil); end"],
  delete_cookie: ["sig { params(name: Symbol).returns(T.untyped) }",
                  "def delete_cookie(name); end"],
  random_token: ["sig { returns(String) }",
                 "def random_token; end"],
  request_ip: ["sig { returns(String) }",
               "def request_ip; end"],
  request_base_url: ["sig { returns(String) }",
                     "def request_base_url; end"],
  # request_query: the raw query string, for a `before` filter.
  request_query: ["sig { returns(String) }",
                  "def request_query; end"],
  # request_path: the URI path, for a `before` filter.
  request_path: ["sig { returns(String) }",
                 "def request_path; end"],
  # request_method: the HTTP method in upper case, for a route or a `before` filter.
  request_method: ["sig { returns(String) }",
                   "def request_method; end"],
  # request_body: the whole request body as UTF-8 text (RawRequestBody), for a route.
  request_body: ["sig { returns(String) }",
                 "def request_body; end"],
  # action_text_html(html): the HTML Action Text stores for a body (stripped, HTML5-parsed and serialized).
  action_text_html: ["sig { params(html: String).returns(String) }",
