  cookie_header: ["sig { params(name: Symbol, value: String, format: T.nilable(Symbol), signed: T.nilable(T::Boolean)).returns(String) }",
                  "def cookie_header(name, value, format: nil, signed: nil); end"],
  respond: ["sig { params(method: Symbol, path: String, body: T.nilable(String), headers: T.nilable(T::Hash[String, String])).returns(T.untyped) }",
            "def respond(method, path, body: nil, headers: nil); end"],
  rate_limited?: ["sig { params(name: String, to: Integer, within: Integer).returns(T::Boolean) }",
                  "def rate_limited?(name, to:, within:); end"],
  request_referrer: ["sig { returns(String) }",
                     "def request_referrer; end"],
  turbo_frame_request?: ["sig { returns(T::Boolean) }",
                         "def turbo_frame_request?; end"],
  turbo_stream_request?: ["sig { returns(T::Boolean) }",
                          "def turbo_stream_request?; end"],
  # current(:name) reads a per-request value; its declaration form (a name, `returns:` and a block) shares this
  # one relaxed sig, as `setting` does, because Sorbet cannot pick an overload on a missing keyword argument.
  current: ["sig { params(name: Symbol, returns: T.untyped, required: T.nilable(Symbol), reader: T.nilable(Symbol), blk: T.untyped).returns(T.untyped) }",
            "def current(name, returns: nil, required: nil, reader: nil, &blk); end"],
  # take_flash reads the flash the redirect into this page carried (a Flash::Message record: on, alert, key, text).
  take_flash: ["sig { returns(T.untyped) }",
               "def take_flash; end"],
  # t("bots.index.title", name: value): Rails' translation lookup (config/locales/*.yml, read at compile time); a String.
  t: ["sig { params(key: String, args: T.untyped).returns(String) }",
      "def t(key, **args); end"]
}.freeze

by_ctx = Hash.new { |h, k| h[k] = [] }
AxumDsl.each_sig { |name, sig| Array(sig.fetch(:in)).each { |ctx| by_ctx[ctx] << [name, sig] } }

lines = [
  "# typed: strict",
  "# GENERATED by bin/gen_rbi from SIG in schema.rb and the body surface (BODY_SURFACE). Do not edit.",
  ""
]
(by_ctx.keys - [:top]).each do |ctx|
  lines << "class #{scope(ctx)}"
  by_ctx[ctx].each_with_index do |(name, sig), i|
    lines << "" if i.positive?
    method_src(name, sig).each { |l| lines << "  #{l}" }
  end
  if %i[params output].include?(ctx)
    # map(:i64) and list(:string) name a field's type; the compiler reads them with Prism and checks the argument.
    lines << "" << "  sig { params(type: Symbol).returns(Symbol) }"
    lines << "  def map(type); end"
    lines << "" << "  sig { params(type: Symbol).returns(Symbol) }"
    lines << "  def list(type); end"
  end
  lines << "end" << ""
end
BODY_SURFACE.each do |name, src|
  next if name == :params # its def is the SIG table's, with this entry as the reader overload (see below)

  src.each { |l| lines << l }
  lines << ""
end
by_ctx[:top].each do |name, sig|
  # `params` is one def with two sigs: Sorbet picks an overload by arity, so the reader sig (no arguments)
  # comes first and the SIG table's declaration sig (a name, a block) follows it.
  lines.concat(BODY_SURFACE.fetch(:params)) if name == :params
  next if %i[setting current head].include?(name) # BODY_SURFACE replaces it, so that the read and the declaration share one sig

  lines.concat(method_src(name, sig)) << ""
end
# Rust::Int32(x) / Rust::Int64(x) mark an integer as "treat this like Rust" (Sorbet just sees Integer).
lines.concat([
  "module Rust",
  "  sig { params(value: Integer).returns(Integer) }",
  "  def self.Int32(value); end",
  "",
  "  sig { params(value: Integer).returns(Integer) }",
  "  def self.Int64(value); end",
  "",
  "  sig { params(value: String).returns(Rust::Str) }",
  "  def self.Str(value); end",
  "",
  "  # A string with Rust `str` behaviour; to_s leaves it.",
  "  class Str",
  "    sig { returns(Rust::Str) }",
  "    def trim; end",
  "",
  "    sig { returns(Rust::Str) }",
  "    def strip; end",
  "",
  "    sig { returns(Rust::Str) }",
  "    def to_lowercase; end",
  "",
  "    sig { returns(Rust::Str) }",
  "    def to_uppercase; end",
  "",
  "    sig { returns(String) }",
  "    def to_s; end",
  "",
  "    sig { returns(Integer) }",
  "    def len; end",
  "",
  "    sig { returns(T::Array[String]) }",
  "    def lines; end",
  "",
  "    sig { params(pat: String).returns(T::Array[String]) }",
  "    def split(pat); end",
  "",
  "    sig { params(pat: String).returns(T::Boolean) }",
  "    def contains(pat); end",
  "",
  "    sig { params(pat: String).returns(T::Boolean) }",
  "    def starts_with?(pat); end",
  "",
  "    sig { params(from: String, to: String).returns(Rust::Str) }",
  "    def replace(from, to); end",
  "  end",
  "end",
  "",
  "# Bcrypt is a compiler built-in, not a binding: bodies call it as Bcrypt.verify / Bcrypt.hash.",
  "module Bcrypt",
  "  sig { params(plain: String, digest: String).returns(T::Boolean) }",
  "  def self.verify(plain, digest); end",
  "",
  "  sig { params(plain: String).returns(String) }",
  "  def self.hash(plain); end",
  "end",
  "",
  "# The macros a binding file (bindings/*.rb) uses; the compiler reads them with Prism.",
  "module AxumDsl",
  "  # A type a binding owns; the compiler reads `type_rust` and a record's `field` lines with Prism.",
  "  class Opaque",
  "    sig { params(rust: String, wire: T::Boolean).void }",
  "    def self.type_rust(rust, wire: false); end",
  "",
  "    sig { params(name: Symbol, type: T.untyped).void }",
  "    def self.field(name, type); end",
  "  end",
  "",
  "  module BindingDsl",
  "    sig { params(name: String, version: String).void }",
  "    def crate(name, version); end",
  "",
  "    sig { params(template: String).void }",
  "    def rust(template); end",
  "",
  "    sig { params(reason: String).void }",
  "    def no_reference(reason); end",
  "",
  "    sig { params(method: Symbol, args: T.untyped, expect: T.untyped).void }",
  "    def example(method, *args, expect:); end",
  "  end",
  "end",
  "",
  "# Sorbet only knows Integer; the compiler reads the names to learn the width.",
  "I32 = T.type_alias { Integer }",
  "I64 = T.type_alias { Integer }",
  ""
])
# The generated text, as a constant so test/test_body_surface.rb can compare it with the file on disk
# without this file writing anything when it is merely loaded.
RBI_TEXT = lines.join("\n")

# Everything above is definitions: the CLI runs only when this file is the program, so loading it (from
# the test) can never write rbi/dsl.rbi.
if __FILE__ == $PROGRAM_NAME
  if ARGV.include?("--print")
    print RBI_TEXT
  elsif ARGV.include?("--check")
    if File.exist?(OUT) && File.read(OUT) == RBI_TEXT
      puts "rbi/dsl.rbi is up to date"
    else
      warn "rbi/dsl.rbi is stale or missing: run `ruby bin/gen_rbi`"
      exit 1
    end
  else
    FileUtils.mkdir_p(File.dirname(OUT))
    File.write(OUT, RBI_TEXT)
    puts "wrote #{OUT}"
  end
end
